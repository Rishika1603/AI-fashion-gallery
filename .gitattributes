# Normalise line endings for files that are consumed by the Linux container.
# A CRLF shebang ("#!/bin/sh\r") makes the entrypoint unexecutable on Railway.
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.template text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.db binary
