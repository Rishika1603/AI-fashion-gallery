# ============================================================
# fashion-ai-gallery — Frontend Environment Variables
# Copy this file to .env.local for local development.
# Set these as build environment variables in your hosting
# platform (Vercel, Netlify, etc.) for production.
# ============================================================

# Backend API base URL
# Development:  http://localhost:8000/api
# Production:   https://api.yourdomain.com/api
#
# Render + Vercel deployment:
#   Vercel  -> Project Settings -> Environment Variables
#   VITE_API_BASE_URL = https://<your-render-service>.onrender.com/api
#
# Note: the value is inlined at BUILD time, so changing it requires a
# redeploy of the frontend.
VITE_API_BASE_URL=http://localhost:8000/api
